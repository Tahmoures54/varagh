# Copy this file to .env locally, then fill in strong, private values.
# Never commit .env or real credentials.
VARAGH_SECRET_KEY=
VARAGH_ADMIN_USERNAME=admin
VARAGH_ADMIN_PASSWORD=
# Optional persistent storage locations:
# VARAGH_DATA_DIR=/absolute/path/to/data
# VARAGH_UPLOAD_DIR=/absolute/path/to/data/receipts
# For HTTPS production only:
# COOKIE_SECURE=1
